generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model StudentProgress {
  student_id String
  major      String
  completed  String @default("[]")
  updated_at BigInt
  user_id    Int
  user       User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([student_id, major])
  @@index([student_id])
  @@index([user_id])
  @@map("student_progress")
}

model StudentProfile {
  student_id       String @id
  major            String
  previous_gpa     Float?
  previous_credits Float?
  updated_at       BigInt
  user_id          Int    @unique
  user             User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("student_profile")
}

model VisitorLog {
  id            Int       @id @default(autoincrement())
  student_id    String?
  ip_address    String?
  user_agent    String?
  device_vendor String?
  device_model  String?
  os_name       String?
  os_version    String?
  browser_name  String?
  visited_at    DateTime? @default(now())
  user_id       Int?
  user          User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([visited_at(sort: Desc)])
  @@map("visitor_logs")
}

model User {
  id                   Int                  @id @default(autoincrement())
  student_id           String?              @unique
  email                String?              @unique
  password_hash        String?
  name                 String?
  image                String?
  created_at           DateTime?            @default(now())
  role                 String?              @default("student")
  updated_at           DateTime?            @default(now())
  accounts             Account[]
  calendar_events      CalendarEvent[]
  gamification_profile GamificationProfile?
  gpa_history          GPAHistory[]
  integration_tokens   IntegrationToken[]
  quests               Quest[]
  semesters            Semester[]
  study_sessions       StudySession[]
  user_badges          UserBadge[]
  student_progress     StudentProgress[]
  student_profile      StudentProfile[]
  visitor_logs         VisitorLog[]
  course_notes         CourseNote[]

  @@map("users")
}

model Account {
  id                  Int    @id @default(autoincrement())
  user_id             Int
  provider            String
  provider_account_id String
  user                User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("accounts")
}

model AdminLog {
  id         Int       @id @default(autoincrement())
  type       String
  message    String?
  details    Json?     @default("{}")
  course_id  Int?
  event_kind String?
  target_id  String?
  created_at DateTime? @default(now())

  course Course? @relation(fields: [course_id], references: [id], onDelete: SetNull)

  @@index([course_id])
  @@index([created_at(sort: Desc)])
  @@index([type])
  @@map("admin_logs")
}

model Semester {
  id             Int            @id @default(autoincrement())
  user_id        Int
  type           String
  year           Int
  name           String
  start_date     DateTime?
  end_date       DateTime?
  semester_gpa   Float?
  created_at     DateTime?      @default(now())
  updated_at     DateTime?      @default(now())
  courses        Course[]
  semester_notes SemesterNote[]
  gpa_history    GPAHistory[]
  quests         Quest[]
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, year, type])
  @@index([user_id])
  @@map("semesters")
}

model SemesterNote {
  id          Int      @id @default(autoincrement())
  semester_id Int
  title       String
  content     Json?    @default("{}")
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  semester    Semester @relation(fields: [semester_id], references: [id], onDelete: Cascade)

  @@index([semester_id])
  @@map("semester_notes")
}

model Course {
  id              Int             @id @default(autoincrement())
  semester_id     Int
  name            String
  code            String
  credits         Float
  instructor_name String?
  location        String?
  class_schedule  Json?           @default("[]")
  status          String?         @default("planned")
  grade_letter    String?
  grade_point     Float?
  final_mark      Float?
  midterm_date    DateTime?
  final_date      DateTime?
  is_completed    Boolean?        @default(false)
  created_at      DateTime?       @default(now())
  updated_at      DateTime?       @default(now())
  calendar_events CalendarEvent[]
  course_notes    CourseNote[]
  semester        Semester        @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  quests          Quest[]
  study_sessions  StudySession[]
  admin_logs      AdminLog[]

  @@unique([semester_id, code])
  @@index([semester_id])
  @@map("courses")
}

model CourseNote {
  course_id    String?
  notes        String?
  content      Json?     @default("{}")
  created_at   DateTime? @default(now())
  db_course_id Int
  id           Int       @id @default(autoincrement())
  student_id   String?
  updated_at   DateTime? @default(now())
  user_id      Int
  db_course    Course    @relation(fields: [db_course_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, db_course_id])
  @@index([user_id, db_course_id])
  @@map("course_notes")
}

model StudySession {
  id               Int       @id @default(autoincrement())
  user_id          Int
  course_id        Int?
  date             DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  duration_minutes Int
  type             String
  notes            String?
  created_at       DateTime? @default(now())
  course           Course?   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([course_id])
  @@index([date(sort: Desc)])
  @@map("study_sessions")
}

model GPAHistory {
  id             Int       @id @default(autoincrement())
  user_id        Int
  semester_id    Int?
  semester_gpa   Float?
  cumulative_gpa Float
  classification String?
  created_at     DateTime? @default(now())
  semester       Semester? @relation(fields: [semester_id], references: [id])
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, semester_id])
  @@index([user_id])
  @@map("gpa_history")
}

model IntegrationToken {
  id                  Int       @id @default(autoincrement())
  student_id          String?
  provider            String
  access_token        String
  refresh_token       String?
  expires_at          BigInt?
  updated_at          DateTime? @default(now())
  created_at          DateTime? @default(now())
  user_id             Int
  metadata            Json?     @default("{}")
  provider_account_id String?
  account_email       String?
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider])
  @@index([user_id])
  @@map("integration_tokens")
}

model CalendarEvent {
  id              Int       @id @default(autoincrement())
  user_id         Int
  course_id       Int?
  type            String
  google_event_id String?
  title           String
  start_datetime  DateTime
  end_datetime    DateTime
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())
  course          Course?   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, google_event_id])
  @@index([user_id, start_datetime])
  @@index([course_id])
  @@map("calendar_events")
}

model GamificationProfile {
  id                  Int       @id @default(autoincrement())
  user_id             Int       @unique
  xp                  Int?      @default(0)
  level               Int?      @default(1)
  current_streak_days Int?      @default(0)
  longest_streak_days Int?      @default(0)
  last_activity_date  DateTime? @db.Date
  created_at          DateTime? @default(now())
  updated_at          DateTime? @default(now())
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("gamification_profiles")
}

model Badge {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  name        String
  description String?
  icon        String?
  created_at  DateTime?   @default(now())
  user_badges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         Int       @id @default(autoincrement())
  user_id    Int
  badge_id   Int
  awarded_at DateTime? @default(now())
  badge      Badge     @relation(fields: [badge_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, badge_id])
  @@index([user_id])
  @@map("user_badges")
}

model Quest {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  scope              String?   @default("global")
  target_course_id   Int?
  target_semester_id Int?
  type               String
  target_value       Float
  current_value      Float?    @default(0)
  status             String?   @default("active")
  expires_at         DateTime?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @default(now())
  course             Course?   @relation(fields: [target_course_id], references: [id], onDelete: Cascade)
  semester           Semester? @relation(fields: [target_semester_id], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("quests")
}
